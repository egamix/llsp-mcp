+
+    @Test
+    void ambiguousSimpleNameIsLeftUnresolved(@TempDir Path tmp) throws Exception {
+        Path javadoc = Files.createDirectories(tmp.resolve("javadoc"));
+        // Two documented types share the simple name "Thing" in different packages.
+        write(javadoc, "com/example/Thing.html", page("class-declaration-page", "Class Thing",
+                "<section class=\"class-description\"><div class=\"block\">One.</div></section>"));
+        write(javadoc, "com/other/Thing.html", page("class-declaration-page", "Class Thing",
+                "<section class=\"class-description\"><div class=\"block\">Two.</div></section>"));
+        // A method returns "Thing" by plain name (no href) — ambiguous across the two candidates.
+        write(javadoc, "com/example/User.html", page("class-declaration-page", "Class User", """
+                <section class="class-description"><div class="block">Uses Thing.</div></section>
+                <section class="method-details" id="method-detail"><ul class="member-list">
+                 <li><section class="detail" id="make()">
+                   <h3>make</h3>
+                   <div class="member-signature">Thing make()</div>
+                   <div class="block">Makes a Thing.</div>
+                 </section></li>
+                </ul></section>
+                """));
+        BuildContext ctx = context(tmp);
+        List<StageFailure> failures = runBothPasses(javadoc, ctx);
+
+        List<StoredRelationshipEdge> edges = readEdges(ctx);
+        assertTrue(edge(edges, "com.example.User#make()", RelationshipType.RETURN_TYPE).isEmpty(),
+                "an ambiguous simple name must not be guessed into an edge");
+        assertTrue(failures.stream().anyMatch(f -> f.severity() == FailureSeverity.RECOVERABLE
+                        && f.message().contains("RETURN_TYPE") && f.message().contains("Thing")),
+                () -> "the ambiguous reference must be a recoverable failure: "
+                        + failures.stream().map(StageFailure::message).toList());
+    }
+
+    // --- AC 3 / Matrix: interrupted-then-resumed yields identical edges/ids, no duplicates ----------
+
+    @Test
+    void rerunningPassTwoIsIdempotentAndByteIdentical(@TempDir Path tmp) throws Exception {
+        Path javadoc = Files.createDirectories(tmp.resolve("javadoc"));
+        writeFullTree(javadoc);
+        BuildContext ctx = context(tmp);
+
+        // Pass one once; pass two twice (the second models a resumed, re-run RELATIONSHIPS stage).
+        List<StageFailure> failures = new ArrayList<>();
+        new CatalogStage(javadoc, new JavadocCatalogSource(), catalogFactory()).execute(ctx, failures::add);
+        new RelationshipsStage(javadoc, new JavadocCatalogSource(), catalogFactory(), relFactory())
+                .execute(ctx, failures::add);
+        List<StoredRelationshipEdge> firstRun = readEdges(ctx);
+
+        new RelationshipsStage(javadoc, new JavadocCatalogSource(), catalogFactory(), relFactory())
+                .execute(ctx, failures::add);
+        List<StoredRelationshipEdge> secondRun = readEdges(ctx);
+
+        assertTrue(failures.isEmpty(), () -> "re-run must not introduce failures: " + failures);
+        assertEquals(firstRun, secondRun, "a resumed pass two must reproduce byte-identical edges and ids");
+    }
+
+    // --- Matrix: identity clash from the store -> BUILD_INVALIDATING --------------------------------
+
+    @Test
+    void storeIdentityClashIsBuildInvalidating(@TempDir Path tmp) throws Exception {
+        Path javadoc = Files.createDirectories(tmp.resolve("javadoc"));
+        write(javadoc, "com/example/Base.html", page("class-declaration-page", "Class Base",
+                "<section class=\"class-description\"><div class=\"block\">Base.</div></section>"));
+        write(javadoc, "com/example/Widget.html", page("class-declaration-page", "Class Widget", """
+                <section class="class-description" id="class-description">
+                  <div class="block">A widget.</div>
+                  <div class="type-signature"><span class="modifiers">public class </span><span class="element-name">Widget</span>
+                   <span class="extends-implements">extends <a href="Base.html">Base</a></span></div>
+                </section>
+                """));
+        BuildContext ctx = context(tmp);
+        List<StageFailure> failures = new ArrayList<>();
+        new CatalogStage(javadoc, new JavadocCatalogSource(), catalogFactory()).execute(ctx, failures::add);
+
+        // A relationship store that reports every put as an identity clash.
+        RelationshipStore clashing = new ClashingStore();
+        new RelationshipsStage(javadoc, new JavadocCatalogSource(), catalogFactory(), c -> clashing)
+                .execute(ctx, failures::add);
+
+        assertTrue(failures.stream().anyMatch(f -> f.stage() == PipelineStage.RELATIONSHIPS
+                        && f.severity() == FailureSeverity.BUILD_INVALIDATING
+                        && f.message().contains("identity clash")),
+                () -> "a store identity clash must be build-invalidating: "
+                        + failures.stream().map(StageFailure::message).toList());
+    }
+
+    /** A relationship store that reports every put as an identity clash (drives the AD-4 clash path). */
+    private static final class ClashingStore implements RelationshipStore {
+        @Override
+        public PutResult put(RelationshipEdge edge) {
+            return new PutResult("edge-" + edge.type() + "-" + edge.sourceSymbol() + "-" + edge.targetSymbol(),
+                    PutStatus.IDENTITY_CLASH);
+        }
+
+        @Override
+        public Optional<StoredRelationshipEdge> findByEdgeId(String edgeId) {
+            return Optional.empty();
+        }
+
+        @Override
+        public List<StoredRelationshipEdge> allEdges() {
+            return List.of();
+        }
+
+        @Override
+        public void close() {
+        }
+    }
+
+    // --- AD-1: cli reaches the stores only through domain ports (no engine type named here) ---------
+
+    @Test
+    void catalogRecordsAndEdgesShareTheOneBuildScopedFile(@TempDir Path tmp) throws Exception {
+        Path javadoc = Files.createDirectories(tmp.resolve("javadoc"));
+        writeFullTree(javadoc);
+        BuildContext ctx = context(tmp);
+        runBothPasses(javadoc, ctx);
+
+        // Records and edges live in the same file (adjacency by record_id into the records table).
+        try (CatalogStore catalog = new SqliteCatalogStore(ctx.catalogDbPath())) {
+            List<StoredCatalogRecord> records = catalog.allRecords();
+            assertFalse(records.isEmpty(), "pass one must have persisted records into the shared file");
+        }
+        assertFalse(readEdges(ctx).isEmpty(), "pass two must have persisted edges into the same file");
+    }
+}
diff --git a/app/domain/src/main/java/com/luciadmcp/knowledge/domain/RelationshipStore.java b/app/domain/src/main/java/com/luciadmcp/knowledge/domain/RelationshipStore.java
new file mode 100644
index 0000000..f83dcc8
--- /dev/null
+++ b/app/domain/src/main/java/com/luciadmcp/knowledge/domain/RelationshipStore.java
@@ -0,0 +1,86 @@
+package com.luciadmcp.knowledge.domain;
+
+import java.util.List;
+import java.util.Optional;
+
+/**
+ * Domain port for the versioned typed-relationship graph store (Story 2.5, AD-1). Mirrors
+ * {@link CatalogStore}: the {@code catalog.sqlite} module provides the sole implementation and no
+ * other module reaches the storage engine except through this interface.
+ *
+ * <p>Pass two submits resolved logical {@link RelationshipEdge} tuples — a
+ * {@code (sourceSymbol, targetSymbol, type, sdkVersion)} where both endpoints are version-scoped
+ * canonical keys already present in the catalog. The store is the sole authority that computes each
+ * edge's ID (AD-22) via {@link ContentHashes#relationshipHash(String, String, RelationshipType,
+ * String, String)} after mapping each endpoint key to its stored {@code record_id}; callers never
+ * compute an ID and never assume a hash recipe.
+ *
+ * <p><b>Version scoping (AD-12).</b> Every persisted edge carries its {@code sdkVersion} and connects
+ * only same-version symbols. <b>Determinism (NFR-13).</b> Edge IDs are pure content hashes, so an
+ * interrupted-then-resumed build persists byte-identical rows and IDs, and reads return a deterministic
+ * order.
+ *
+ * <p>The SQLite edges schema/DDL remains a governance approval gate (Epic 3); the current
+ * implementation is a clearly-labeled provisional schema (Story 2.5), mirroring the Story 2.4 catalog
+ * precedent.
+ */
+public interface RelationshipStore extends AutoCloseable {
+
+    /**
+     * Persists one logical edge, mapping each endpoint canonical key to its stored {@code record_id},
+     * computing the edge ID from those IDs (AD-22), and deduplicating by it. The write is an idempotent
+     * upsert: submitting the same logical edge twice leaves a single row ({@link PutStatus#DUPLICATE}).
+     * A <em>different</em> logical edge that resolves to the same identity is an explicit clash
+     * ({@link PutStatus#IDENTITY_CLASH}) — never a silent overwrite or drop (AD-4). Structural edges
+     * pass {@code evidence=""}; the evidence dimension exists for Epic-3 example reuse (AD-30).
+     *
+     * @param edge the resolved logical edge tuple (both endpoints are catalog canonical keys)
+     * @return the computed edge ID and the outcome ({@link PutStatus})
+     */
+    PutResult put(RelationshipEdge edge);
+
+    /** The stored edge for a computed edge ID, or empty if none. */
+    Optional<StoredRelationshipEdge> findByEdgeId(String edgeId);
+
+    /** Every persisted edge, in a deterministic order (ascending edge ID). */
+    List<StoredRelationshipEdge> allEdges();
+
+    /** Closes the underlying store. Overridden to declare no checked exception for try-with-resources. */
+    @Override
+    void close();
+
+    /** The outcome of a {@link #put(RelationshipEdge)} call. */
+    enum PutStatus {
+
+        /** The edge was newly inserted. */
+        INSERTED,
+
+        /** An identical edge was already present; the upsert was a no-op (idempotent). */
+        DUPLICATE,
+
+        /**
+         * A different logical edge already occupies this identity — a real identity clash. The
+         * existing row is left untouched; the caller records an issue per the failure policy (AD-4).
+         */
+        IDENTITY_CLASH
+    }
+
+    /**
+     * The result of a {@link #put(RelationshipEdge)}: the store-computed edge ID (AD-22) and the
+     * outcome.
+     *
+     * @param edgeId the computed edge ID
+     * @param status whether the edge was inserted, already present, or clashed
+     */
+    record PutResult(String edgeId, PutStatus status) {
+
+        public PutResult {
+            if (edgeId == null || edgeId.isBlank()) {
+                throw new IllegalArgumentException("edgeId must not be blank");
+            }
+            if (status == null) {
+                throw new IllegalArgumentException("status must not be null");
+            }
+        }
+    }
+}
diff --git a/app/domain/src/main/java/com/luciadmcp/knowledge/domain/StoredRelationshipEdge.java b/app/domain/src/main/java/com/luciadmcp/knowledge/domain/StoredRelationshipEdge.java
new file mode 100644
index 0000000..e5e26da
--- /dev/null
+++ b/app/domain/src/main/java/com/luciadmcp/knowledge/domain/StoredRelationshipEdge.java
@@ -0,0 +1,26 @@
+package com.luciadmcp.knowledge.domain;
+
+/**
+ * A persisted relationship edge read back from {@link RelationshipStore}: the store-computed edge ID
+ * (AD-22) paired with the logical {@link RelationshipEdge} that was submitted.
+ *
+ * <p>The {@code edgeId} is assigned solely by the store from the {@link ContentHashes#relationshipHash
+ * relationshipHash} recipe; it is never supplied by pass two. On read, the store reconstructs the
+ * logical edge's version-scoped canonical endpoint keys from the persisted {@code record_id}s, so the
+ * same logical edge always round-trips to the same {@link RelationshipEdge} and the same ID (NFR-13
+ * determinism).
+ *
+ * @param edgeId the deterministic content-hash ID the store assigned (AD-22)
+ * @param edge   the logical edge tuple, endpoints as version-scoped canonical keys
+ */
+public record StoredRelationshipEdge(String edgeId, RelationshipEdge edge) {
+
+    public StoredRelationshipEdge {
+        if (edgeId == null || edgeId.isBlank()) {
+            throw new IllegalArgumentException("edgeId must not be blank");
+        }
+        if (edge == null) {
+            throw new IllegalArgumentException("edge must not be null");
+        }
+    }
+}
diff --git a/app/ingest-javadoc/src/main/java/com/luciadmcp/knowledge/ingest/javadoc/TypeRef.java b/app/ingest-javadoc/src/main/java/com/luciadmcp/knowledge/ingest/javadoc/TypeRef.java
new file mode 100644
index 0000000..4d129d1
--- /dev/null
+++ b/app/ingest-javadoc/src/main/java/com/luciadmcp/knowledge/ingest/javadoc/TypeRef.java
@@ -0,0 +1,42 @@
+package com.luciadmcp.knowledge.ingest.javadoc;
+
+/**
+ * One relationship-source reference extracted from a Javadoc page (Story 2.5): the documented target
+ * text plus, when the page rendered the reference as a link, the href resolved into the ingested tree.
+ *
+ * <p>An {@code ingest.javadoc}-internal contract like {@link ExtractedType}/{@link ExtractedMember} —
+ * not a {@code domain} record. It carries only what the page states: the target's documented
+ * {@link #name} (a type name — simple or fully-qualified — or a member display text) and, for a linked
+ * reference, the link's {@link #relativePath} (root-relative, {@code /}-separated) and {@link #anchor}.
+ * Pass two (the {@code cli} RELATIONSHIPS stage) resolves these against the completed catalog: a
+ * link-bearing reference resolves via the catalog's persisted {@code (relativePath, anchor)} — reliable
+ * and member-precise — and a plain name falls back to FQN then unique simple-name. No resolution or
+ * canonical-symbol minting happens here (AD-4 two-pass discipline).
+ *
+ * <p>{@link #relativePath} is empty when the page did not link the reference (or linked it outside the
+ * tree, e.g. an absolute URL); {@link #anchor} is empty for a type target or a same-page member link's
+ * bare page. The {@code relativePath} is already resolved relative to the referring page (so it matches
+ * the root-relative path the catalog persists), never the raw page-relative href.
+ *
+ * @param name         the documented target text (never null; may be empty for a bare link)
+ * @param relativePath the link target's root-relative {@code /}-separated path, or {@code ""} if none
+ * @param anchor       the link's on-page fragment, or {@code ""} if none
+ */
+public record TypeRef(String name, String relativePath, String anchor) {
+
+    public TypeRef {
+        name = name == null ? "" : name;
+        relativePath = relativePath == null ? "" : relativePath;
+        anchor = anchor == null ? "" : anchor;
+    }
+
+    /** A plain (unlinked) reference to a documented target by its {@code name}. */
+    public static TypeRef ofName(String name) {
+        return new TypeRef(name, "", "");
+    }
+
+    /** Whether this reference carries a link into the ingested tree (a resolved root-relative path). */
+    public boolean hasHref() {
+        return !relativePath.isBlank();
+    }
+}
diff --git a/app/ingest-javadoc/src/test/java/com/luciadmcp/knowledge/ingest/javadoc/JavadocRelationshipExtractionTest.java b/app/ingest-javadoc/src/test/java/com/luciadmcp/knowledge/ingest/javadoc/JavadocRelationshipExtractionTest.java
new file mode 100644
index 0000000..26045f6
--- /dev/null
+++ b/app/ingest-javadoc/src/test/java/com/luciadmcp/knowledge/ingest/javadoc/JavadocRelationshipExtractionTest.java
@@ -0,0 +1,210 @@
+package com.luciadmcp.knowledge.ingest.javadoc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import org.jsoup.Jsoup;
+import org.jsoup.nodes.Document;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Story 2.5 extraction: the field extractor captures the relationship-source references — a type's
+ * superclass / super-interfaces / implemented-interfaces / see-also, and each member's return/field
+ * type, overrides, specified-by, see-also — with their link hrefs (resolved to root-relative paths),
+ * identically for modern (JDK 11+) and legacy (JDK 8) layouts. Fixtures are synthetic (no proprietary
+ * content).
+ */
+class JavadocRelationshipExtractionTest {
+
+    private final JavadocFieldExtractor extractor = new JavadocFieldExtractor();
+
+    private static final String MODERN_WIDGET = """
+            <!DOCTYPE html><html><head><title>Widget</title></head>
+            <body class="class-declaration-page">
+            <main>
+            <h1 class="title">Class Widget</h1>
+            <section class="class-description" id="class-description">
+              <div class="block">A widget.</div>
+              <hr>
+              <div class="type-signature"><span class="modifiers">public class </span><span class="element-name">Widget</span>
+               <span class="extends-implements">extends <a href="Base.html" title="class in com.example">Base</a>
+               implements <a href="Drawable.html" title="interface in com.example">Drawable</a></span></div>
+              <dl class="notes"><dt>See Also:</dt><dd><a href="Point.html"><code>Point</code></a></dd></dl>
+            </section>
+            <section class="method-details" id="method-detail">
+              <ul class="member-list">
+               <li><section class="detail" id="getOrigin()">
+                 <h3>getOrigin</h3>
+                 <div class="member-signature"><span class="return-type"><a href="Point.html">Point</a></span>&nbsp;getOrigin()</div>
+                 <div class="block">Gets it.</div>
+               </section></li>
+               <li><section class="detail" id="doThing(int)">
+                 <h3>doThing</h3>
+                 <div class="member-signature">void&nbsp;doThing&#8203;(int&nbsp;count)</div>
+                 <div class="block">Does.</div>
+                 <dl class="notes"><dt>Overrides:</dt>
+                  <dd><code><a href="Base.html#doThing(int)">doThing</a></code> in class <code><a href="Base.html">Base</a></code></dd></dl>
+               </section></li>
+               <li><section class="detail" id="draw()">
+                 <h3>draw</h3>
+                 <div class="member-signature">void&nbsp;draw()</div>
+                 <div class="block">Draws.</div>
+                 <dl class="notes"><dt>Specified by:</dt>
+                  <dd><code><a href="Drawable.html#draw()">draw</a></code> in interface <code><a href="Drawable.html">Drawable</a></code></dd></dl>
+               </section></li>
+              </ul>
+            </section>
+            <section class="field-details" id="field-detail">
+              <ul class="member-list">
+               <li><section class="detail" id="anchor">
+                 <h3>anchor</h3>
+                 <div class="member-signature"><a href="Point.html">Point</a>&nbsp;anchor</div>
+                 <div class="block">Anchor.</div>
+               </section></li>
+              </ul>
+            </section>
+            </main></body></html>
+            """;
+
+    private static final String LEGACY_WIDGET = """
+            <!DOCTYPE html><html><head><title>Widget</title></head>
+            <body>
+            <div class="header"><h2 class="title">Class Widget</h2></div>
+            <div class="contentContainer">
+            <div class="description"><ul class="blockList"><li class="blockList">
+              <pre>public class Widget
+            extends <a href="Base.html" title="class in com.example">Base</a>
+            implements <a href="Drawable.html" title="interface in com.example">Drawable</a></pre>
+              <div class="block">A widget.</div>
+            </li></ul></div>
+            <div class="details"><ul class="blockList">
+             <li class="blockList"><h3>Method Detail</h3>
+              <ul class="blockList"><li class="blockList">
+                <h4>doThing</h4>
+                <pre>void doThing(int count)</pre>
+                <div class="block">Does.</div>
+                <dl><dt><span class="overrideSpecifyLabel">Overrides:</span></dt>
+                 <dd><code><a href="Base.html#doThing(int)">doThing</a></code>&nbsp;in class&nbsp;<code><a href="Base.html">Base</a></code></dd></dl>
+              </li></ul>
+             </li>
+            </ul></div>
+            </div>
+            </body></html>
+            """;
+
+    private static final String LEGACY_INTERFACE = """
+            <!DOCTYPE html><html><head><title>Shape</title></head>
+            <body>
+            <div class="header"><h2 class="title">Interface Shape</h2></div>
+            <div class="contentContainer">
+            <div class="description"><ul class="blockList"><li class="blockList">
+              <pre>public interface Shape
+            extends <a href="Drawable.html" title="interface in com.example">Drawable</a></pre>
+              <div class="block">A shape.</div>
+            </li></ul></div>
+            </div>
+            </body></html>
+            """;
+
+    private ExtractedType extract(String html, String path) {
+        Document doc = Jsoup.parse(html);
+        ExtractionResult result = extractor.extract(doc, path);
+        assertTrue(result.issues().isEmpty(), () -> path + " issues: " + result.issues());
+        return result.type();
+    }
+
+    private static ExtractedMember member(ExtractedType type, String name) {
+        return type.members().stream().filter(m -> m.name().equals(name)).findFirst()
+                .orElseThrow(() -> new AssertionError("no member named " + name));
+    }
+
+    /** Modern: superclass, implemented interface, type see-also all captured with resolved hrefs. */
+    @Test
+    void modernTypeHeaderAndSeeAlsoCaptureHrefs() {
+        ExtractedType type = extract(MODERN_WIDGET, "com/example/Widget.html");
+
+        assertNotNull(type.superclass(), "superclass must be captured");
+        assertEquals("Base", type.superclass().name());
+        assertEquals("com/example/Base.html", type.superclass().relativePath());
+        assertEquals("", type.superclass().anchor());
+
+        assertEquals(1, type.implementedInterfaces().size());
+        assertEquals("com/example/Drawable.html", type.implementedInterfaces().get(0).relativePath());
+        assertTrue(type.superInterfaces().isEmpty(), "a class has no super-interfaces");
+
+        assertEquals(1, type.seeAlso().size());
+        assertEquals("com/example/Point.html", type.seeAlso().get(0).relativePath());
+    }
+
+    /** Modern: return type, field type (href from signature), overrides + specified-by (href from notes). */
+    @Test
+    void modernMemberReferencesCaptureHrefs() {
+        ExtractedType type = extract(MODERN_WIDGET, "com/example/Widget.html");
+
+        ExtractedMember getOrigin = member(type, "getOrigin");
+        assertNotNull(getOrigin.returnType());
+        assertEquals("Point", getOrigin.returnType().name());
+        assertEquals("com/example/Point.html", getOrigin.returnType().relativePath());
+
+        ExtractedMember anchor = member(type, "anchor");
+        assertNotNull(anchor.fieldType());
+        assertEquals("com/example/Point.html", anchor.fieldType().relativePath());
+
+        ExtractedMember doThing = member(type, "doThing");
+        assertNotNull(doThing.overrides(), "Overrides: note must be captured");
+        assertEquals("com/example/Base.html", doThing.overrides().relativePath());
+        assertEquals("doThing(int)", doThing.overrides().anchor(), "the override is member-precise (anchored)");
+        assertNull(doThing.returnType(), "a void method names no documented return type");
+
+        ExtractedMember draw = member(type, "draw");
+        assertNotNull(draw.specifiedBy(), "Specified by: note must be captured");
+        assertEquals("com/example/Drawable.html", draw.specifiedBy().relativePath());
+        assertEquals("draw()", draw.specifiedBy().anchor());
+    }
+
+    /** Legacy JDK 8: the {@code <pre>} type header yields the same superclass/interface references. */
+    @Test
+    void legacyTypeHeaderCaptureHrefs() {
+        ExtractedType type = extract(LEGACY_WIDGET, "com/example/Widget.html");
+        assertNotNull(type.superclass());
+        assertEquals("com/example/Base.html", type.superclass().relativePath());
+        assertEquals(1, type.implementedInterfaces().size());
+        assertEquals("com/example/Drawable.html", type.implementedInterfaces().get(0).relativePath());
+
+        ExtractedMember doThing = member(type, "doThing");
+        assertNotNull(doThing.overrides());
+        assertEquals("com/example/Base.html", doThing.overrides().relativePath());
+        assertEquals("doThing(int)", doThing.overrides().anchor());
+    }
+
+    /** Legacy interface: the {@code extends} clause is captured as super-interfaces, not a superclass. */
+    @Test
+    void legacyInterfaceExtendsIsSuperInterface() {
+        ExtractedType type = extract(LEGACY_INTERFACE, "com/example/Shape.html");
+        assertNull(type.superclass(), "an interface has no superclass");
+        assertTrue(type.implementedInterfaces().isEmpty(), "an interface implements nothing");
+        assertEquals(1, type.superInterfaces().size());
+        assertEquals("Drawable", type.superInterfaces().get(0).name());
+        assertEquals("com/example/Drawable.html", type.superInterfaces().get(0).relativePath());
+    }
+
+    /** An absent header (no signature element) yields no relationship references, not a crash. */
+    @Test
+    void undocumentedHeaderYieldsNoReferences() {
+        String bare = """
+                <!DOCTYPE html><html><head><title>Bare</title></head>
+                <body class="class-declaration-page">
+                <main><h1 class="title">Class Bare</h1>
+                <section class="class-description"><div class="block">Bare.</div></section>
+                </main></body></html>
+                """;
+        ExtractedType type = extract(bare, "com/example/Bare.html");
+        assertNull(type.superclass());
+        assertTrue(type.superInterfaces().isEmpty());
+        assertTrue(type.implementedInterfaces().isEmpty());
+        assertEquals(List.of(), type.seeAlso());
+    }
+}
