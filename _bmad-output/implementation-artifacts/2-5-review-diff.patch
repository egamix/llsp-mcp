index 0000000..a574499
--- /dev/null
+++ b/app/catalog-sqlite/src/main/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStore.java
@@ -0,0 +1,281 @@
+package com.luciadmcp.knowledge.catalog.sqlite;
+
+import com.luciadmcp.knowledge.domain.ContentHashes;
+import com.luciadmcp.knowledge.domain.RelationshipEdge;
+import com.luciadmcp.knowledge.domain.RelationshipStore;
+import com.luciadmcp.knowledge.domain.RelationshipType;
+import com.luciadmcp.knowledge.domain.StoredRelationshipEdge;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+
+/**
+ * SQLite implementation of the {@link RelationshipStore} domain port (Story 2.5). It is the sole
+ * authority that computes edge IDs (AD-22): it maps each submitted endpoint canonical key to its
+ * stored {@code record_id} on the shared build-scoped catalog file, then hashes the edge identity with
+ * {@link ContentHashes#relationshipHash(String, String, RelationshipType, String, String)} — no other
+ * module computes an edge ID. It opens the <em>same</em> build-scoped SQLite file the catalog wrote
+ * (Story 2.4), so the {@code records} table it resolves against and the {@code edges} table it writes
+ * live together.
+ *
+ * <h2>Provisional schema — pending governance sign-off</h2>
+ *
+ * <p>The concrete {@code edges} DDL below is a working, clearly-labeled <b>provisional</b> schema,
+ * mirroring the Story-2.4 catalog precedent. The SQLite relationship schema (adjacency +
+ * recursive-CTE traversal) is a {@code [NEEDS APPROVAL]} governance gate (ARCHITECTURE-SPINE
+ * Deferred, Epic 3); this is not the approved DDL. Identity inputs are captured explicitly
+ * ({@code sdk_version}, {@code source_id}, {@code type}, {@code target_id}, {@code evidence}) so a
+ * later approved schema maps on without reshaping. {@code evidence} is empty for the 13 Javadoc
+ * structural edges (it is an example-link concern, AD-30) but the column exists for Epic-3 reuse.
+ *
+ * <ul>
+ *   <li><b>{@code edge_id}</b> — TEXT primary key, the AD-22 computed content hash.</li>
+ *   <li><b>Identity uniqueness</b> — {@code UNIQUE(sdk_version, source_id, type, target_id, evidence)}:
+ *       exactly the fields folded into {@code edge_id}, so the index and the hash agree.</li>
+ *   <li><b>Version scoping</b> — every edge carries {@code sdk_version} and both endpoints are
+ *       resolved from the same version's records (AD-12).</li>
+ * </ul>
+ *
+ * <h2>Idempotent upsert &amp; identity clash (AD-4)</h2>
+ *
+ * <p>Because the edge ID is a pure function of the version-scoped edge identity, submitting the same
+ * logical edge twice resolves to the same ID and leaves one row ({@link PutStatus#DUPLICATE}).
+ * Submitting a <em>different</em> logical edge that resolves to the same identity is a real clash: the
+ * existing row is left untouched and {@link PutStatus#IDENTITY_CLASH} is returned so the caller can
+ * record an issue — never a silent overwrite or drop.
+ *
+ * <h2>Determinism (NFR-13)</h2>
+ *
+ * <p>Nothing here reads the clock, a random source, or a locale-dependent transform; IDs are pure
+ * content hashes and reads are ordered by ascending {@code edge_id}. An interrupted-then-resumed build
+ * re-submitting the same edges yields byte-identical rows and IDs. AD-9: SQLite runs in-process
+ * against a local file; no socket is opened.
+ */
+public final class SqliteRelationshipStore implements RelationshipStore {
+
+    /** Provisional edges-table DDL (pending governance sign-off). */
+    static final String CREATE_EDGES_TABLE =
+            "CREATE TABLE IF NOT EXISTS edges ("
+                    + "edge_id TEXT PRIMARY KEY NOT NULL, "
+                    + "sdk_version TEXT NOT NULL, "
+                    + "source_id TEXT NOT NULL, "
+                    + "type TEXT NOT NULL, "
+                    + "target_id TEXT NOT NULL, "
+                    + "evidence TEXT NOT NULL, "
+                    + "UNIQUE(sdk_version, source_id, type, target_id, evidence)"
+                    + ")";
+
+    /** Structural edges carry no evidence (AD-30); the column exists for Epic-3 example reuse. */
+    private static final String STRUCTURAL_EVIDENCE = "";
+
+    private final Connection connection;
+
+    /**
+     * Opens (creating if absent) the build-scoped catalog file at {@code dbPath} — the same file the
+     * catalog store wrote — and creates the provisional {@code edges} table. The {@code records} table
+     * is owned by {@link SqliteCatalogStore} and is expected to already exist (the catalog stage runs
+     * first); this store only reads it to resolve endpoint keys.
+     *
+     * @param dbPath the build-scoped SQLite file path (coordinator-owned; AD-25)
+     */
+    public SqliteRelationshipStore(Path dbPath) {
+        if (dbPath == null) {
+            throw new IllegalArgumentException("dbPath must not be null");
+        }
+        Path absolute = dbPath.toAbsolutePath().normalize();
+        Path parent = absolute.getParent();
+        if (parent != null) {
+            try {
+                Files.createDirectories(parent);
+            } catch (IOException e) {
+                throw new UncheckedIOException("could not create relationship store directory " + parent, e);
+            }
+        }
+        Connection opened = null;
+        try {
+            opened = DriverManager.getConnection("jdbc:sqlite:" + absolute);
+            try (Statement stmt = opened.createStatement()) {
+                stmt.execute(CREATE_EDGES_TABLE);
+            }
+            this.connection = opened;
+        } catch (SQLException e) {
+            closeQuietly(opened);
+            throw new IllegalStateException("could not open relationship store at " + absolute, e);
+        }
+    }
+
+    private static void closeQuietly(Connection connection) {
+        if (connection == null) {
+            return;
+        }
+        try {
+            connection.close();
+        } catch (SQLException ignored) {
+            // Best-effort cleanup on a failed open; the original failure is what the caller sees.
+        }
+    }
+
+    @Override
+    public PutResult put(RelationshipEdge edge) {
+        if (edge == null) {
+            throw new IllegalArgumentException("edge must not be null");
+        }
+        // The store maps each endpoint canonical key to its stored record_id — it never trusts the
+        // caller to supply an id. A key with no matching version-scoped record is an integrity failure:
+        // pass two only ever submits resolved catalog symbols, so this must not happen silently.
+        String sourceId = resolveRecordId(edge.sdkVersion(), edge.sourceSymbol());
+        if (sourceId == null) {
+            throw new IllegalStateException("no catalog record for source key '" + edge.sourceSymbol()
+                    + "' (SDK version " + edge.sdkVersion() + ")");
+        }
+        String targetId = resolveRecordId(edge.sdkVersion(), edge.targetSymbol());
+        if (targetId == null) {
+            throw new IllegalStateException("no catalog record for target key '" + edge.targetSymbol()
+                    + "' (SDK version " + edge.sdkVersion() + ")");
+        }
+
+        String edgeId = ContentHashes.relationshipHash(
+                edge.sdkVersion(), sourceId, edge.type(), targetId, STRUCTURAL_EVIDENCE);
+
+        Optional<StoredRelationshipEdge> existing = findByEdgeId(edgeId);
+        if (existing.isPresent()) {
+            // Same identity already stored: idempotent no-op if the logical edge matches, otherwise a
+            // real identity clash — two distinct logical edges claiming one identity (AD-4).
+            return existing.get().edge().equals(edge)
+                    ? new PutResult(edgeId, PutStatus.DUPLICATE)
+                    : new PutResult(edgeId, PutStatus.IDENTITY_CLASH);
+        }
+
+        String sql = "INSERT INTO edges (edge_id, sdk_version, source_id, type, target_id, evidence) "
+                + "VALUES (?, ?, ?, ?, ?, ?)";
+        try (PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, edgeId);
+            ps.setString(2, edge.sdkVersion());
+            ps.setString(3, sourceId);
+            ps.setString(4, edge.type().name());
+            ps.setString(5, targetId);
+            ps.setString(6, STRUCTURAL_EVIDENCE);
+            ps.executeUpdate();
+            return new PutResult(edgeId, PutStatus.INSERTED);
+        } catch (SQLException e) {
+            // Defensive: a UNIQUE(identity) violation without an edge_id match means a different
+            // logical edge already occupies this identity — a real clash, not a silent drop (AD-4).
+            if (isIdentityConstraintViolation(e)) {
+                return new PutResult(edgeId, PutStatus.IDENTITY_CLASH);
+            }
+            throw new IllegalStateException("could not persist relationship edge " + edgeId, e);
+        }
+    }
+
+    @Override
+    public Optional<StoredRelationshipEdge> findByEdgeId(String edgeId) {
+        if (edgeId == null || edgeId.isBlank()) {
+            throw new IllegalArgumentException("edgeId must not be blank");
+        }
+        String sql = SELECT_EDGE_JOIN + " WHERE e.edge_id = ?";
+        try (PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, edgeId);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? Optional.of(read(rs)) : Optional.empty();
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("could not query relationship edge by id", e);
+        }
+    }
+
+    @Override
+    public List<StoredRelationshipEdge> allEdges() {
+        // Ascending edge_id gives a deterministic order independent of insertion sequence (NFR-13).
+        String sql = SELECT_EDGE_JOIN + " ORDER BY e.edge_id ASC";
+        List<StoredRelationshipEdge> out = new ArrayList<>();
+        try (Statement stmt = connection.createStatement();
+                ResultSet rs = stmt.executeQuery(sql)) {
+            while (rs.next()) {
+                out.add(read(rs));
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("could not enumerate relationship edges", e);
+        }
+        return out;
+    }
+
+    @Override
+    public void close() {
+        try {
+            connection.close();
+        } catch (SQLException e) {
+            throw new IllegalStateException("could not close relationship store", e);
+        }
+    }
+
+    // Reconstruct the logical edge by joining each stored record_id back to its version-scoped
+    // canonical key on the records table (Story 2.4). The store persists ids, not keys, but reads
+    // return keys so a submitted logical edge round-trips unchanged (NFR-13).
+    private static final String SELECT_EDGE_JOIN =
+            "SELECT e.edge_id AS edge_id, e.sdk_version AS sdk_version, e.type AS type, "
+                    + "s.canonical_key AS source_key, t.canonical_key AS target_key "
+                    + "FROM edges e "
+                    + "JOIN records s ON s.record_id = e.source_id "
+                    + "JOIN records t ON t.record_id = e.target_id";
+
+    private static StoredRelationshipEdge read(ResultSet rs) throws SQLException {
+        String edgeId = rs.getString("edge_id");
+        RelationshipEdge edge = new RelationshipEdge(
+                rs.getString("source_key"),
+                rs.getString("target_key"),
+                RelationshipType.valueOf(rs.getString("type")),
+                rs.getString("sdk_version"));
+        return new StoredRelationshipEdge(edgeId, edge);
+    }
+
+    /** The stored {@code record_id} for a version-scoped canonical key, or {@code null} if none. */
+    private String resolveRecordId(String sdkVersion, String canonicalKey) {
+        String sql = "SELECT record_id FROM records WHERE sdk_version = ? AND canonical_key = ?";
+        try (PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, sdkVersion);
+            ps.setString(2, canonicalKey);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? rs.getString("record_id") : null;
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("could not resolve endpoint record id for key " + canonicalKey, e);
+        }
+    }
+
+    // SQLite result codes (see sqlite.org/rescode.html). getErrorCode() carries the primary code
+    // (19 = SQLITE_CONSTRAINT) or, when the driver surfaces it, the extended code that pinpoints which
+    // constraint failed.
+    private static final int SQLITE_CONSTRAINT = 19;
+    private static final int SQLITE_CONSTRAINT_PRIMARYKEY = 1555; // 19 | (6 << 8)
+    private static final int SQLITE_CONSTRAINT_UNIQUE = 2067;     // 19 | (8 << 8)
+
+    /**
+     * Whether a failed {@code INSERT} is a {@code UNIQUE(identity)} violation — a real identity clash —
+     * as opposed to a genuine storage error. Uses the SQLite result code rather than scanning the
+     * (driver-text/locale-dependent) message. A primary-key ({@code edge_id}) collision is explicitly
+     * <em>not</em> treated as a clash: it cannot occur here because {@link #put} checks
+     * {@link #findByEdgeId} first, so if it ever surfaced it is a real error and must propagate.
+     */
+    private static boolean isIdentityConstraintViolation(SQLException e) {
+        int code = e.getErrorCode();
+        if (code == SQLITE_CONSTRAINT_UNIQUE) {
+            return true;
+        }
+        if (code == SQLITE_CONSTRAINT_PRIMARYKEY) {
+            return false;
+        }
+        // Only the primary constraint code is available (no extended detail): our INSERT is guarded by
+        // findByEdgeId, so a constraint failure here can only be the identity UNIQUE index.
+        return (code & 0xFF) == SQLITE_CONSTRAINT;
+    }
+}
diff --git a/app/catalog-sqlite/src/test/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStoreTest.java b/app/catalog-sqlite/src/test/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStoreTest.java
new file mode 100644
index 0000000..5e17e3a
--- /dev/null
+++ b/app/catalog-sqlite/src/test/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStoreTest.java
@@ -0,0 +1,189 @@
+package com.luciadmcp.knowledge.catalog.sqlite;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.luciadmcp.knowledge.domain.CatalogRecord;
+import com.luciadmcp.knowledge.domain.ContentHashes;
+import com.luciadmcp.knowledge.domain.RelationshipEdge;
+import com.luciadmcp.knowledge.domain.RelationshipStore;
+import com.luciadmcp.knowledge.domain.RelationshipType;
+import com.luciadmcp.knowledge.domain.StoredRelationshipEdge;
+import java.nio.file.Path;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/**
+ * The versioned SQLite relationship store (Story 2.5): it maps endpoint canonical keys to their stored
+ * {@code record_id}s, computes {@code edge_id} via {@link ContentHashes#relationshipHash} as the sole
+ * edge-ID authority (AD-22), upserts idempotently, reproduces byte-identical rows/ids on resume
+ * (NFR-13), returns a deterministic order, and refuses an endpoint with no catalog record. Fixtures are
+ * synthetic; no proprietary content.
+ */
+class SqliteRelationshipStoreTest {
+
+    private static final String V = "2024.0";
+
+    /** Seeds the shared catalog file with the type records the edges connect. */
+    private static void seedRecords(Path db, String... fqns) {
+        try (SqliteCatalogStore catalog = new SqliteCatalogStore(db)) {
+            for (String fqn : fqns) {
+                catalog.put(new CatalogRecord(V, fqn, "TYPE", fqn, simpleOf(fqn), pathOf(fqn), ""));
+            }
+        }
+    }
+
+    private static String simpleOf(String fqn) {
+        int dot = fqn.lastIndexOf('.');
+        return dot >= 0 ? fqn.substring(dot + 1) : fqn;
+    }
+
+    private static String pathOf(String fqn) {
+        return fqn.replace('.', '/') + ".html";
+    }
+
+    private static Path db(Path dir) {
+        return dir.resolve("catalog.sqlite");
+    }
+
+    private static RelationshipEdge extendsClass(String sub, String sup) {
+        return new RelationshipEdge(sub, sup, RelationshipType.EXTENDS_CLASS, V);
+    }
+
+    /** AD-22: edge_id is exactly relationshipHash over the resolved endpoint record ids — no other recipe. */
+    @Test
+    void edgeIdIsTheRelationshipContentHashOverResolvedRecordIds(@TempDir Path tmp) {
+        Path db = db(tmp);
+        seedRecords(db, "com.example.Widget", "com.example.Base");
+
+        String sourceId;
+        String targetId;
+        try (SqliteCatalogStore catalog = new SqliteCatalogStore(db)) {
+            sourceId = catalog.findByKey(V, "com.example.Widget").orElseThrow().recordId();
+            targetId = catalog.findByKey(V, "com.example.Base").orElseThrow().recordId();
+        }
+        String expected =
+                ContentHashes.relationshipHash(V, sourceId, RelationshipType.EXTENDS_CLASS, targetId, "");
+
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            RelationshipStore.PutResult result = store.put(extendsClass("com.example.Widget", "com.example.Base"));
+            assertEquals(RelationshipStore.PutStatus.INSERTED, result.status());
+            assertEquals(expected, result.edgeId(), "edge id must be the relationshipHash of the record ids");
+        }
+    }
+
+    /** Matrix row "Duplicate edge within a build": identical logical edge upserts to one row. */
+    @Test
+    void duplicateSubmissionIsIdempotent(@TempDir Path tmp) {
+        Path db = db(tmp);
+        seedRecords(db, "com.example.Widget", "com.example.Base");
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            RelationshipStore.PutResult first = store.put(extendsClass("com.example.Widget", "com.example.Base"));
+            RelationshipStore.PutResult second = store.put(extendsClass("com.example.Widget", "com.example.Base"));
+
+            assertEquals(RelationshipStore.PutStatus.INSERTED, first.status());
+            assertEquals(RelationshipStore.PutStatus.DUPLICATE, second.status(),
+                    "re-submitting the same logical edge is a no-op");
+            assertEquals(first.edgeId(), second.edgeId(), "the same logical edge yields the same id");
+            assertEquals(1, store.allEdges().size(), "an idempotent upsert leaves exactly one row");
+        }
+    }
+
+    /** The submitted logical edge round-trips (endpoints reconstructed as canonical keys). */
+    @Test
+    void edgeRoundTripsAsCanonicalKeys(@TempDir Path tmp) {
+        Path db = db(tmp);
+        seedRecords(db, "com.example.Widget", "com.example.Base");
+        RelationshipEdge edge = extendsClass("com.example.Widget", "com.example.Base");
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            String edgeId = store.put(edge).edgeId();
+            StoredRelationshipEdge back = store.findByEdgeId(edgeId).orElseThrow();
+            assertEquals(edge, back.edge(), "the logical edge must round-trip unchanged");
+            assertEquals(List.of(back), store.allEdges());
+        }
+    }
+
+    /** Matrix row "Interrupted then resumed": re-running over the same file reproduces rows/ids. */
+    @Test
+    void resumeOverSameFileReproducesEdgesAndIds(@TempDir Path tmp) {
+        Path db = db(tmp);
+        seedRecords(db, "com.example.Widget", "com.example.Base", "com.example.Drawable");
+
+        List<StoredRelationshipEdge> firstRun;
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            store.put(extendsClass("com.example.Widget", "com.example.Base"));
+            store.put(new RelationshipEdge(
+                    "com.example.Widget", "com.example.Drawable", RelationshipType.IMPLEMENTS, V));
+            firstRun = store.allEdges();
+        }
+
+        // A resumed run re-submits the same edges: idempotent, byte-identical rows and ids.
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            assertEquals(RelationshipStore.PutStatus.DUPLICATE,
+                    store.put(extendsClass("com.example.Widget", "com.example.Base")).status());
+            assertEquals(RelationshipStore.PutStatus.DUPLICATE,
+                    store.put(new RelationshipEdge(
+                            "com.example.Widget", "com.example.Drawable", RelationshipType.IMPLEMENTS, V)).status());
+            assertEquals(firstRun, store.allEdges(), "a resumed run must reproduce identical edges and ids");
+            assertEquals(2, store.allEdges().size());
+        }
+    }
+
+    /** NFR-13: allEdges is deterministically ordered (ascending id), independent of insertion order. */
+    @Test
+    void allEdgesIsDeterministicallyOrdered(@TempDir Path tmp) {
+        seedRecords(db(tmp.resolve("f")), "com.example.A", "com.example.B", "com.example.C");
+        seedRecords(db(tmp.resolve("r")), "com.example.A", "com.example.B", "com.example.C");
+
+        List<StoredRelationshipEdge> forward;
+        try (RelationshipStore store = new SqliteRelationshipStore(db(tmp.resolve("f")))) {
+            store.put(new RelationshipEdge("com.example.A", "com.example.B", RelationshipType.SEE_ALSO, V));
+            store.put(new RelationshipEdge("com.example.A", "com.example.C", RelationshipType.SEE_ALSO, V));
+            forward = store.allEdges();
+        }
+        List<StoredRelationshipEdge> reverse;
+        try (RelationshipStore store = new SqliteRelationshipStore(db(tmp.resolve("r")))) {
+            store.put(new RelationshipEdge("com.example.A", "com.example.C", RelationshipType.SEE_ALSO, V));
+            store.put(new RelationshipEdge("com.example.A", "com.example.B", RelationshipType.SEE_ALSO, V));
+            reverse = store.allEdges();
+        }
+        assertEquals(forward, reverse, "edge order must not depend on insertion order");
+        assertTrue(forward.get(0).edgeId().compareTo(forward.get(1).edgeId()) <= 0,
+                "edges must be ordered by ascending id");
+    }
+
+    /** NFR-13: two independent builds of the same inputs assign byte-identical edge ids. */
+    @Test
+    void independentBuildsOfSameInputsAssignSameIds(@TempDir Path tmp) {
+        seedRecords(db(tmp.resolve("a")), "com.example.Widget", "com.example.Base");
+        seedRecords(db(tmp.resolve("b")), "com.example.Widget", "com.example.Base");
+
+        String idA;
+        String idB;
+        try (RelationshipStore sa = new SqliteRelationshipStore(db(tmp.resolve("a")))) {
+            idA = sa.put(extendsClass("com.example.Widget", "com.example.Base")).edgeId();
+        }
+        try (RelationshipStore sb = new SqliteRelationshipStore(db(tmp.resolve("b")))) {
+            idB = sb.put(extendsClass("com.example.Widget", "com.example.Base")).edgeId();
+        }
+        assertEquals(idA, idB, "the same logical edge must hash to the same id across builds");
+    }
+
+    /**
+     * AD-4 / AD-22: the store resolves endpoints itself; an endpoint canonical key with no catalog
+     * record for the version is an integrity failure, refused (never invented an id from the key text).
+     */
+    @Test
+    void endpointWithNoCatalogRecordIsRefused(@TempDir Path tmp) {
+        Path db = db(tmp);
+        seedRecords(db, "com.example.Widget"); // Base is NOT seeded
+        try (RelationshipStore store = new SqliteRelationshipStore(db)) {
+            IllegalStateException e = assertThrows(IllegalStateException.class,
+                    () -> store.put(extendsClass("com.example.Widget", "com.example.Base")));
+            assertTrue(e.getMessage().contains("com.example.Base"),
+                    () -> "the message should name the unresolved endpoint: " + e.getMessage());
+        }
+    }
+}
diff --git a/app/cli/src/main/java/com/luciadmcp/knowledge/cli/pipeline/RelationshipsStage.java b/app/cli/src/main/java/com/luciadmcp/knowledge/cli/pipeline/RelationshipsStage.java
new file mode 100644
index 0000000..4de8c55
--- /dev/null
+++ b/app/cli/src/main/java/com/luciadmcp/knowledge/cli/pipeline/RelationshipsStage.java
@@ -0,0 +1,528 @@
+package com.luciadmcp.knowledge.cli.pipeline;
+
+import com.luciadmcp.knowledge.domain.CatalogStore;
+import com.luciadmcp.knowledge.domain.RelationshipEdge;
+import com.luciadmcp.knowledge.domain.RelationshipStore;
+import com.luciadmcp.knowledge.domain.RelationshipType;
+import com.luciadmcp.knowledge.domain.StoredCatalogRecord;
+import com.luciadmcp.knowledge.ingest.javadoc.ExtractedMember;
+import com.luciadmcp.knowledge.ingest.javadoc.ExtractedType;
+import com.luciadmcp.knowledge.ingest.javadoc.JavadocCatalogSource;
+import com.luciadmcp.knowledge.ingest.javadoc.SymbolKind;
+import com.luciadmcp.knowledge.ingest.javadoc.SymbolRecord;
+import com.luciadmcp.knowledge.ingest.javadoc.ThrownException;
+import com.luciadmcp.knowledge.ingest.javadoc.TypeRef;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.Function;
+
+/**
+ * The real {@link PipelineStage#RELATIONSHIPS} stage (Story 2.5): the end-to-end pass-two
+ * graph-construction path. It reads the catalog persisted by pass one, re-parses the Javadoc tree for
+ * the relationship-source references (which the catalog does not persist), resolves each documented
+ * reference to a catalog symbol, emits the 13 Javadoc <b>structural</b> typed edges, materializes the
+ * two inverse pairs, and submits every edge through the {@link RelationshipStore} port — which alone
+ * computes edge IDs and persists version-scoped rows (AD-22).
+ *
+ * <p><b>Two-pass, never fabricate (AD-4).</b> Pass one is the persisted catalog (Story 2.4); pass two
+ * resolves references against the <em>completed</em> catalog only. An edge is emitted only when both
+ * endpoints are catalog symbols in the same SDK version (AD-12). A reference that does not resolve is
+ * surfaced as a {@link FailureSeverity#RECOVERABLE} failure — never fabricated, never silently dropped;
+ * the first-class stored unresolved-reference model and traversal-scope reporting are Story 2.6.
+ *
+ * <p><b>Why re-parse.</b> The catalog persists only identity + {@code (relativePath, anchor)}, not
+ * supertype/param/see-also facts, so pass two re-parses the tree (deterministic) for the <em>source</em>
+ * references and resolves <em>targets</em> against the completed catalog. This is the AD-4 two-pass
+ * shape, not a parse of convenience.
+ *
+ * <p><b>Resolution ladder (minimal, Story 2.5).</b> (1) a reference carrying an href into the ingested
+ * tree resolves via the catalog's persisted {@code (relativePath, anchor)} — reliable and
+ * member-precise (this is how {@code OVERRIDES}/{@code SPECIFIED_BY} reach a specific supertype method);
+ * (2) otherwise a plain type name resolves by fully-qualified name, else by a <em>unique</em>
+ * simple-name match; (3) otherwise it is unresolved. Language primitives and {@code void} name no
+ * documented type and are neither edges nor failures.
+ *
+ * <p><b>Inverse derivation (golden).</b> After emitting a resolved {@code EXTENDS_CLASS(a→b)} the stage
+ * also emits {@code DIRECT_SUBCLASS(b→a)}, and after {@code IMPLEMENTS(a→b)} it emits
+ * {@code IMPLEMENTED_BY(b→a)} — derived, never parsed from a second source, so the two directions can
+ * never disagree. The other 9 structural types have no named inverse and are single-direction.
+ *
+ * <p><b>Dependency direction (AD-1).</b> This stage lives in {@code cli}. It drives Javadoc parsing only
+ * through {@link JavadocCatalogSource} (no JSoup type crosses the boundary) and reaches both stores only
+ * through {@code domain} ports; the concrete SQLite stores are supplied by the wiring via factories, so
+ * this class names no engine type.
+ *
+ * <h2>Failure mapping</h2>
+ * <ul>
+ *   <li><b>Unresolved reference</b> &rarr; {@link FailureSeverity#RECOVERABLE} (per the failure policy).</li>
+ *   <li><b>Store open/close, re-parse, or persistence integrity failure, and an edge identity clash</b>
+ *       &rarr; {@link FailureSeverity#BUILD_INVALIDATING}: relationship-graph integrity is compromised.</li>
+ * </ul>
+ */
+public final class RelationshipsStage implements Stage {
+
+    private final Path javadocRoot;
+    private final JavadocCatalogSource source;
+    private final Function<BuildContext, CatalogStore> catalogStoreFactory;
+    private final Function<BuildContext, RelationshipStore> relationshipStoreFactory;
+
+    /**
+     * @param javadocRoot              the Javadoc tree root to re-parse (validated by {@code IngestCommand})
+     * @param source                   the Story-2.1&ndash;2.3 discover/extract/mint facade (now also
+     *                                 exposing the relationship-source references per type)
+     * @param catalogStoreFactory      opens the build-scoped {@link CatalogStore} to read the catalog
+     *                                 for the resolution index
+     * @param relationshipStoreFactory opens the build-scoped {@link RelationshipStore} to persist edges
+     */
+    public RelationshipsStage(
+            Path javadocRoot,
+            JavadocCatalogSource source,
+            Function<BuildContext, CatalogStore> catalogStoreFactory,
+            Function<BuildContext, RelationshipStore> relationshipStoreFactory) {
+        this.javadocRoot = javadocRoot;
+        this.source = source;
+        this.catalogStoreFactory = catalogStoreFactory;
+        this.relationshipStoreFactory = relationshipStoreFactory;
+    }
+
+    @Override
+    public void execute(BuildContext context, Consumer<StageFailure> failures) {
+        String version = context.sdkVersion();
+
+        // 1. Build the resolution index from the persisted catalog (pass one's completed output).
+        ResolutionIndex index;
+        try (CatalogStore catalog = catalogStoreFactory.apply(context)) {
+            index = ResolutionIndex.build(catalog.allRecords(), version);
+        } catch (RuntimeException e) {
+            failures.accept(StageFailure.of(
+                    PipelineStage.RELATIONSHIPS,
+                    FailureSeverity.BUILD_INVALIDATING,
+                    "could not read catalog for relationship resolution: " + e.getMessage()));
+            return;
+        }
+
+        // 2. Re-parse the tree for the source references (deterministic; AD-4 two-pass).
+        JavadocCatalogSource.Result parsed;
+        try {
+            parsed = source.ingest(javadocRoot);
+        } catch (RuntimeException e) {
+            failures.accept(StageFailure.of(
+                    PipelineStage.RELATIONSHIPS,
+                    FailureSeverity.BUILD_INVALIDATING,
+                    "Javadoc re-parse for relationships failed under " + javadocRoot + ": " + e.getMessage()));
+            return;
+        }
+
+        // 3. Persist edges through the store (the sole edge-ID authority, AD-22).
+        RelationshipStore store;
+        try {
+            store = relationshipStoreFactory.apply(context);
+        } catch (RuntimeException e) {
+            failures.accept(StageFailure.of(
+                    PipelineStage.RELATIONSHIPS,
+                    FailureSeverity.BUILD_INVALIDATING,
+                    "could not open relationship store: " + e.getMessage()));
+            return;
+        }
+        try {
+            for (JavadocCatalogSource.PageResult page : parsed.pages()) {
+                emitPage(version, page, index, store, failures);
+            }
+        } catch (RuntimeException e) {
+            // A genuine storage/integrity error (e.g. an endpoint key with no catalog record) compromises
+            // graph integrity — route it through the policy as build-invalidating, not raw.
+            failures.accept(StageFailure.of(
+                    PipelineStage.RELATIONSHIPS,
+                    FailureSeverity.BUILD_INVALIDATING,
+                    "relationship persistence failed: " + e.getMessage()));
+        } finally {
+            try {
+                store.close();
+            } catch (RuntimeException e) {
+                failures.accept(StageFailure.of(
+                        PipelineStage.RELATIONSHIPS,
+                        FailureSeverity.BUILD_INVALIDATING,
+                        "could not close relationship store: " + e.getMessage()));
+            }
+        }
+    }
+
+    /** Emits every structural edge for one type page (type-level then per-member), plus inverses. */
+    private void emitPage(
+            String version,
+            JavadocCatalogSource.PageResult page,
+            ResolutionIndex index,
+            RelationshipStore store,
+            Consumer<StageFailure> failures) {
+        Path file = javadocRoot.resolve(page.relativePath());
+        ExtractedType type = page.type();
+
+        // The type-level record (memberIndex == -1) is the source for the type-header + type see-also
+        // edges; member records supply their own source keys and line up with type.members() by index.
+        SymbolRecord typeRecord = null;
+        for (SymbolRecord record : page.records()) {
+            if (record.kind() == SymbolKind.TYPE) {
+                typeRecord = record;
+                break;
+            }
+        }
+
+        if (typeRecord != null && type != null) {
+            String typeKey = typeRecord.canonicalKey();
+            // EXTENDS_CLASS + derived DIRECT_SUBCLASS (inverse).
+            resolveType(type.superclass(), index).ifPresentOrElse(
+                    target -> {
+                        submit(store, version, typeKey, target, RelationshipType.EXTENDS_CLASS, file, failures);
+                        submit(store, version, target, typeKey, RelationshipType.DIRECT_SUBCLASS, file, failures);
+                    },
+                    () -> unresolved(type.superclass(), "EXTENDS_CLASS", typeKey, file, failures));
+            // EXTENDS_INTERFACE (single direction).
+            for (TypeRef ref : type.superInterfaces()) {
+                resolveType(ref, index).ifPresentOrElse(
+                        target -> submit(store, version, typeKey, target,
+                                RelationshipType.EXTENDS_INTERFACE, file, failures),
+                        () -> unresolved(ref, "EXTENDS_INTERFACE", typeKey, file, failures));
+            }
+            // IMPLEMENTS + derived IMPLEMENTED_BY (inverse).
+            for (TypeRef ref : type.implementedInterfaces()) {
+                resolveType(ref, index).ifPresentOrElse(
+                        target -> {
+                            submit(store, version, typeKey, target, RelationshipType.IMPLEMENTS, file, failures);
+                            submit(store, version, target, typeKey, RelationshipType.IMPLEMENTED_BY, file, failures);
+                        },
+                        () -> unresolved(ref, "IMPLEMENTS", typeKey, file, failures));
+            }
+            // Type-level SEE_ALSO (single direction; may target a type or a member).
+            for (TypeRef ref : type.seeAlso()) {
+                resolveAny(ref, index).ifPresentOrElse(
+                        target -> submit(store, version, typeKey, target,
+                                RelationshipType.SEE_ALSO, file, failures),
+                        () -> unresolved(ref, "SEE_ALSO", typeKey, file, failures));
+            }
+        }
+
+        List<ExtractedMember> members = type == null ? List.of() : type.members();
+        for (SymbolRecord record : page.records()) {
+            int idx = record.memberIndex();
+            if (idx < 0 || idx >= members.size()) {
+                continue; // the type record, or a member whose index fell outside the extracted list
+            }
+            emitMember(version, record, members.get(idx), index, store, file, failures);
+        }
+    }
+
+    private void emitMember(
+            String version,
+            SymbolRecord record,
+            ExtractedMember member,
+            ResolutionIndex index,
+            RelationshipStore store,
+            Path file,
+            Consumer<StageFailure> failures) {
+        String sourceKey = record.canonicalKey();
+
+        // RETURN_TYPE (methods) / FIELD_TYPE (fields, enum constants).
+        if (record.kind() == SymbolKind.METHOD) {
+            emitTypeRef(version, sourceKey, member.returnType(), RelationshipType.RETURN_TYPE,
+                    index, store, file, failures);
+        } else if (record.kind() == SymbolKind.FIELD || record.kind() == SymbolKind.ENUM_CONSTANT) {
+            emitTypeRef(version, sourceKey, member.fieldType(), RelationshipType.FIELD_TYPE,
+                    index, store, file, failures);
+        }
+
+        // PARAMETER_TYPE / CONSTRUCTOR_PARAMETER_TYPE — from the minted erased parameter types (plain
+        // names, resolved by FQN / unique simple name).
+        RelationshipType paramType = record.kind() == SymbolKind.CONSTRUCTOR
+                ? RelationshipType.CONSTRUCTOR_PARAMETER_TYPE
+                : RelationshipType.PARAMETER_TYPE;
+        for (String erased : record.erasedParameterTypes()) {
+            emitNameRef(version, sourceKey, erased, paramType, index, store, file, failures);
+        }
+
+        // THROWS_TYPE — from the documented @throws type names.
+        for (ThrownException thrown : member.throwsTypes()) {
+            emitNameRef(version, sourceKey, thrown.type(), RelationshipType.THROWS_TYPE,
+                    index, store, file, failures);
+        }
+
+        // OVERRIDES / SPECIFIED_BY — member-precise; resolved by href only, never guessed by name.
+        emitMemberPrecise(version, sourceKey, member.overrides(), RelationshipType.OVERRIDES,
+                index, store, file, failures);
+        emitMemberPrecise(version, sourceKey, member.specifiedBy(), RelationshipType.SPECIFIED_BY,
+                index, store, file, failures);
+
+        // Member-level SEE_ALSO (may target a type or a member).
+        for (TypeRef ref : member.seeAlso()) {
+            resolveAny(ref, index).ifPresentOrElse(
+                    target -> submit(store, version, sourceKey, target,
+                            RelationshipType.SEE_ALSO, file, failures),
+                    () -> unresolved(ref, "SEE_ALSO", sourceKey, file, failures));
+        }
+    }
+
+    /** Emits a type-target edge from a {@link TypeRef} (href then name), or records it unresolved. */
+    private void emitTypeRef(
+            String version, String sourceKey, TypeRef ref, RelationshipType type,
+            ResolutionIndex index, RelationshipStore store, Path file, Consumer<StageFailure> failures) {
+        if (ref == null || isPrimitiveOrVoid(ref.name())) {
+            return; // no reference (constructor/void) or a primitive — never an edge, never a failure
+        }
+        resolveType(ref, index).ifPresentOrElse(
+                target -> submit(store, version, sourceKey, target, type, file, failures),
+                () -> unresolved(ref, type.name(), sourceKey, file, failures));
+    }
+
+    /** Emits a type-target edge from a plain erased/documented name, or records it unresolved. */
+    private void emitNameRef(
+            String version, String sourceKey, String name, RelationshipType type,
+            ResolutionIndex index, RelationshipStore store, Path file, Consumer<StageFailure> failures) {
+        if (name == null || name.isBlank() || isPrimitiveOrVoid(name)) {
+            return;
+        }
+        String target = index.resolveTypeByName(name);
+        if (target != null) {
+            submit(store, version, sourceKey, target, type, file, failures);
+        } else {
+            unresolvedName(name, type.name(), sourceKey, file, failures);
+        }
+    }
+
+    /** Emits a member-precise edge (href only); an unlinked or unmatched target stays unresolved. */
+    private void emitMemberPrecise(
+            String version, String sourceKey, TypeRef ref, RelationshipType type,
+            ResolutionIndex index, RelationshipStore store, Path file, Consumer<StageFailure> failures) {
+        if (ref == null) {
+            return;
+        }
+        String target = index.resolveByHref(ref);
+        if (target != null) {
+            submit(store, version, sourceKey, target, type, file, failures);
+        } else {
+            unresolved(ref, type.name(), sourceKey, file, failures);
+        }
+    }
+
+    /** Resolves a type target: href into the tree, else FQN, else a unique simple name. */
+    private static java.util.Optional<String> resolveType(TypeRef ref, ResolutionIndex index) {
+        if (ref == null) {
+            return java.util.Optional.empty();
+        }
+        String byHref = index.resolveByHref(ref);
+        if (byHref != null) {
+            return java.util.Optional.of(byHref);
+        }
+        String byName = index.resolveTypeByName(ref.name());
+        return java.util.Optional.ofNullable(byName);
+    }
+
+    /** Resolves a see-also target: href (type or member) into the tree, else a type by name. */
+    private static java.util.Optional<String> resolveAny(TypeRef ref, ResolutionIndex index) {
+        if (ref == null) {
+            return java.util.Optional.empty();
+        }
+        String byHref = index.resolveByHref(ref);
+        if (byHref != null) {
+            return java.util.Optional.of(byHref);
+        }
+        return java.util.Optional.ofNullable(index.resolveTypeByName(ref.name()));
+    }
+
+    private void submit(
+            RelationshipStore store, String version, String sourceKey, String targetKey,
+            RelationshipType type, Path file, Consumer<StageFailure> failures) {
+        RelationshipStore.PutResult result =
+                store.put(new RelationshipEdge(sourceKey, targetKey, type, version));
+        if (result.status() == RelationshipStore.PutStatus.IDENTITY_CLASH) {
+            // A real identity clash compromises graph integrity — never overwrite or drop (AD-4).
+            failures.accept(StageFailure.ofFile(
+                    PipelineStage.RELATIONSHIPS,
+                    FailureSeverity.BUILD_INVALIDATING,
+                    file,
+                    "identity clash persisting " + type + " edge " + sourceKey + " -> " + targetKey
+                            + " (SDK version " + version + "); computed edge id " + result.edgeId()));
+        }
+    }
+
+    private void unresolved(
+            TypeRef ref, String type, String sourceKey, Path file, Consumer<StageFailure> failures) {
+        if (ref == null) {
+            return;
+        }
+        String detail = ref.hasHref()
+                ? "'" + ref.name() + "' (link " + ref.relativePath()
+                        + (ref.anchor().isBlank() ? "" : "#" + ref.anchor()) + ")"
+                : "'" + ref.name() + "'";
+        failures.accept(StageFailure.ofFile(
+                PipelineStage.RELATIONSHIPS,
+                FailureSeverity.RECOVERABLE,
+                file,
+                "unresolved " + type + " reference " + detail + " from " + sourceKey
+                        + "; no edge emitted (explicit unresolved model deferred to Story 2.6)"));
+    }
+
+    private void unresolvedName(
+            String name, String type, String sourceKey, Path file, Consumer<StageFailure> failures) {
+        failures.accept(StageFailure.ofFile(
+                PipelineStage.RELATIONSHIPS,
+                FailureSeverity.RECOVERABLE,
+                file,
+                "unresolved " + type + " reference '" + name + "' from " + sourceKey
+                        + "; no edge emitted (explicit unresolved model deferred to Story 2.6)"));
+    }
+
+    /** Language primitives and {@code void} — never documented types, so never references to resolve. */
+    private static boolean isPrimitiveOrVoid(String name) {
+        String base = name;
+        // Strip array/varargs markers to test the element type.
+        while (base.endsWith("[]")) {
+            base = base.substring(0, base.length() - 2);
+        }
+        if (base.endsWith("...")) {
+            base = base.substring(0, base.length() - 3);
+        }
+        return switch (base) {
+            case "void", "boolean", "byte", "char", "short", "int", "long", "float", "double" -> true;
+            default -> false;
+        };
+    }
+
+    /**
+     * The pass-two resolution index over the completed catalog for one SDK version: {@code (path,
+     * anchor)} &rarr; canonical key for link-precise resolution, and type-record FQN / simple-name maps
+     * for plain-name resolution. Built once per run from {@code allRecords()} (deterministic).
+     */
+    static final class ResolutionIndex {
+
+        private final Map<String, String> byPathAnchor;
+        private final Map<String, String> byFqnType;
+        private final Map<String, List<String>> bySimpleType;
+
+        private ResolutionIndex(
+                Map<String, String> byPathAnchor,
+                Map<String, String> byFqnType,
+                Map<String, List<String>> bySimpleType) {
+            this.byPathAnchor = byPathAnchor;
+            this.byFqnType = byFqnType;
+            this.bySimpleType = bySimpleType;
+        }
+
+        static ResolutionIndex build(List<StoredCatalogRecord> records, String version) {
+            Map<String, String> byPathAnchor = new HashMap<>();
+            Map<String, String> byFqnType = new HashMap<>();
+            Map<String, List<String>> bySimpleType = new HashMap<>();
+            for (StoredCatalogRecord stored : records) {
+                var record = stored.record();
+                if (!record.sdkVersion().equals(version)) {
+                    continue; // edges connect only same-version symbols (AD-12)
+                }
+                byPathAnchor.put(
+                        pathAnchorKey(record.relativePath(), record.anchor()), record.canonicalKey());
+                if ("TYPE".equals(record.kind())) {
+                    byFqnType.put(record.typeFqn(), record.canonicalKey());
+                    if (!record.simpleName().isBlank()) {
+                        bySimpleType.computeIfAbsent(record.simpleName(), k -> new ArrayList<>())
+                                .add(record.canonicalKey());
+                    }
+                }
+            }
+            return new ResolutionIndex(byPathAnchor, byFqnType, bySimpleType);
+        }
+
+        /** The canonical key at a link's {@code (relativePath, anchor)}, or {@code null} if none. */
+        String resolveByHref(TypeRef ref) {
+            if (ref == null || !ref.hasHref()) {
+                return null;
+            }
+            return byPathAnchor.get(pathAnchorKey(ref.relativePath(), ref.anchor()));
+        }
+
+        /** The canonical key for a type by FQN, else by a unique simple name; {@code null} otherwise. */
+        String resolveTypeByName(String name) {
+            if (name == null || name.isBlank()) {
+                return null;
+            }
+            if (name.indexOf('.') >= 0) {
+                String byFqn = byFqnType.get(name);
+                if (byFqn != null) {
+                    return byFqn;
+                }
+            }
+            String simple = lastDotSegment(name);
+            List<String> candidates = bySimpleType.get(simple);
+            return (candidates != null && candidates.size() == 1) ? candidates.get(0) : null;
+        }
+
+        private static String pathAnchorKey(String relativePath, String anchor) {
+            return relativePath + "#" + normalizeAnchor(anchor);
+        }
+    }
+
+    /**
+     * Normalizes a member anchor so a catalog anchor (built from erased <em>simple</em> parameter type
+     * names) and a Javadoc link anchor (which may carry fully-qualified parameter types) compare equal:
+     * generics are erased and each parameter type is reduced to its last dotted segment. A type/field
+     * anchor (no parameter list) passes through unchanged; the transform is idempotent on an
+     * already-simple anchor.
+     */
+    static String normalizeAnchor(String anchor) {
+        if (anchor == null || anchor.isBlank()) {
+            return "";
+        }
+        int open = anchor.indexOf('(');
+        if (open < 0) {
+            return anchor; // a field / type anchor
+        }
+        int close = anchor.lastIndexOf(')');
+        String name = anchor.substring(0, open);
+        String inner = close > open ? anchor.substring(open + 1, close) : anchor.substring(open + 1);
+        inner = eraseAngles(inner).trim();
+        List<String> params = new ArrayList<>();
+        if (!inner.isEmpty()) {
+            for (String part : inner.split(",")) {
+                String p = part.trim();
+                if (p.isEmpty()) {
+                    continue;
+                }
+                int dims = 0;
+                while (p.endsWith("[]")) {
+                    dims++;
+                    p = p.substring(0, p.length() - 2);
+                }
+                if (p.endsWith("...")) {
+                    dims++;
+                    p = p.substring(0, p.length() - 3);
+                }
+                p = lastDotSegment(p) + "[]".repeat(dims);
+                params.add(p);
+            }
+        }
+        return name + "(" + String.join(",", params) + ")";
+    }
+
+    private static String lastDotSegment(String name) {
+        int dot = name.lastIndexOf('.');
+        return dot >= 0 ? name.substring(dot + 1) : name;
+    }
+
+    private static String eraseAngles(String s) {
+        StringBuilder out = new StringBuilder(s.length());
+        int depth = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '<') {
+                depth++;
+            } else if (c == '>') {
+                if (depth > 0) {
+                    depth--;
+                }
+            } else if (depth == 0) {
+                out.append(c);
+            }
+        }
+        return out.toString();
+    }
+}
