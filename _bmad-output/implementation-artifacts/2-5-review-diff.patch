diff --git a/app/catalog-sqlite/src/main/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStore.java b/app/catalog-sqlite/src/main/java/com/luciadmcp/knowledge/catalog/sqlite/SqliteRelationshipStore.java
