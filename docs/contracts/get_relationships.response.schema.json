{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "get_relationships.response.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "read-tools/2"
    },
    "tool": {
      "const": "get_relationships"
    },
    "sdkVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ],
      "description": "Actual pinned source SDK, never inferred from target context; null before source binding."
    },
    "buildId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "proof": {
      "$ref": "common.schema.json#/$defs/proof"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 50
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "edgeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "targetId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "family": {
                    "enum": [
                      "SDK",
                      "KNOWLEDGE_DEPENDENCY"
                    ]
                  },
                  "proof": {
                    "enum": [
                      "EXACT",
                      "AMBIGUOUS",
                      "UNKNOWN_IN_SCOPE",
                      "INCOMPLETE_EVIDENCE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "originalToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "maxItems": 50
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": [
                  "edgeId",
                  "sourceId",
                  "targetId",
                  "type",
                  "family",
                  "proof",
                  "originalToken",
                  "candidates",
                  "reason"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "family": {
                          "const": "SDK"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "type": {
                          "enum": [
                            "EXTENDS_CLASS",
                            "EXTENDS_INTERFACE",
                            "IMPLEMENTS",
                            "IMPLEMENTED_BY",
                            "DIRECT_SUBCLASS",
                            "RETURN_TYPE",
                            "PARAMETER_TYPE",
                            "THROWS_TYPE",
                            "FIELD_TYPE",
                            "CONSTRUCTOR_PARAMETER_TYPE",
                            "OVERRIDES",
                            "SPECIFIED_BY",
                            "SEE_ALSO",
                            "WORKFLOW_REQUIRES",
                            "USES_TYPE",
                            "CONSTRUCTS",
                            "CALLS"
                          ]
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "type": {
                          "enum": [
                            "REQUIRED",
                            "OPTIONAL",
                            "SUPERSEDES"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "proof": {
                          "const": "EXACT"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "targetId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "targetId": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              },
              "maxItems": 50
            }
          },
          "required": [
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    },
    "counts": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "emptyReason": {
      "anyOf": [
        {
          "enum": [
            "NO_MATCH",
            "UNKNOWN_IN_SCOPE",
            "INCOMPLETE_EVIDENCE",
            "NOT_APPLICABLE",
            "NOT_REQUESTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "normalizedQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "matchedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 50
        },
        "candidatesExamined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "workCharged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "capabilityFingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "normalizedQuery",
        "matchedBy",
        "candidatesExamined",
        "workCharged",
        "capabilityFingerprint"
      ],
      "additionalProperties": false
    },
    "targetSdkVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "versionNotices": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "common.schema.json#/$defs/versionNotice"
      }
    }
  },
  "required": [
    "contractVersion",
    "tool",
    "sdkVersion",
    "buildId",
    "proof",
    "data",
    "error",
    "counts",
    "coverage",
    "emptyReason",
    "truncated",
    "continuation",
    "trace",
    "targetSdkVersion",
    "versionNotices"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "buildId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "sdkVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "proof": {
            "const": "NOT_APPLICABLE"
          },
          "continuation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "buildId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "null"
              }
            }
          },
          "sdkVersion": {
            "type": "null"
          },
          "versionNotices": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "sdkVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  ]
}
