{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolve_symbol.response.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "read-tools/1"
    },
    "tool": {
      "const": "resolve_symbol"
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "buildId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "proof": {
      "$ref": "common.schema.json#/$defs/proof"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "matches": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/item"
              },
              "maxItems": 50
            }
          },
          "required": [
            "matches"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    },
    "counts": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "emptyReason": {
      "anyOf": [
        {
          "enum": [
            "NO_MATCH",
            "UNKNOWN_IN_SCOPE",
            "INCOMPLETE_EVIDENCE",
            "NOT_APPLICABLE",
            "NOT_REQUESTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "normalizedQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "matchedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 50
        },
        "candidatesExamined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "workCharged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "capabilityFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "normalizedQuery",
        "matchedBy",
        "candidatesExamined",
        "workCharged",
        "capabilityFingerprint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "tool",
    "sdkVersion",
    "buildId",
    "proof",
    "data",
    "error",
    "counts",
    "coverage",
    "emptyReason",
    "truncated",
    "continuation",
    "trace"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "proof": {
            "const": "NOT_APPLICABLE"
          },
          "continuation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
