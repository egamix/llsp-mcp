{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check_symbols.response.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "read-tools/1"
    },
    "tool": {
      "const": "check_symbols"
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "buildId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "proof": {
      "$ref": "common.schema.json#/$defs/proof"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verdicts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "proof": {
                    "enum": [
                      "EXACT",
                      "AMBIGUOUS",
                      "UNKNOWN_IN_SCOPE",
                      "INCOMPLETE_EVIDENCE",
                      "NOT_APPLICABLE"
                    ]
                  },
                  "selectedRecordId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "candidateRecordIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "maxItems": 50
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "input",
                  "proof",
                  "selectedRecordId",
                  "candidateRecordIds",
                  "reason"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            }
          },
          "required": [
            "verdicts"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    },
    "counts": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "emptyReason": {
      "anyOf": [
        {
          "enum": [
            "NO_MATCH",
            "UNKNOWN_IN_SCOPE",
            "INCOMPLETE_EVIDENCE",
            "NOT_APPLICABLE",
            "NOT_REQUESTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "normalizedQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "matchedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 50
        },
        "candidatesExamined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "workCharged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "capabilityFingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "normalizedQuery",
        "matchedBy",
        "candidatesExamined",
        "workCharged",
        "capabilityFingerprint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "tool",
    "sdkVersion",
    "buildId",
    "proof",
    "data",
    "error",
    "counts",
    "coverage",
    "emptyReason",
    "truncated",
    "continuation",
    "trace"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "buildId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "proof": {
            "const": "NOT_APPLICABLE"
          },
          "continuation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "buildId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    }
  ]
}
