{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolve_symbol.request.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "read-tools/2"
    },
    "buildId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "$ref": "common.schema.json#/$defs/limits"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "includeAliases": {
      "type": "boolean",
      "default": true
    },
    "targetSdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Optional user context; never an implicit source filter or compatibility claim."
    },
    "sourceSdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Explicit restrictive source filter; absent selects one configured usable source within bounded work."
    }
  },
  "required": [
    "contractVersion",
    "symbol"
  ],
  "additionalProperties": false
}
