{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index_status.response.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "read-tools/2"
    },
    "tool": {
      "const": "index_status"
    },
    "sdkVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ],
      "description": "Actual pinned source SDK, never inferred from target context; null before source binding."
    },
    "buildId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "proof": {
      "$ref": "common.schema.json#/$defs/proof"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "STAGING",
                "VALIDATED",
                "ACTIVE",
                "UNAVAILABLE"
              ]
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 50
            },
            "technicalRatification": {
              "enum": [
                "PENDING",
                "APPROVED"
              ]
            },
            "schemaVersion": {
              "const": 1
            },
            "identityVersion": {
              "const": "identity/1"
            },
            "runtimeFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "recipeFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "capabilityFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sdkVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "buildId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "compatible": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "LEXICAL",
                "CATALOG_ONLY"
              ]
            },
            "coverage": {
              "type": "object",
              "properties": {
                "pages": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/$defs/count"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "records": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/$defs/count"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sections": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/$defs/count"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "pages",
                "records",
                "sections"
              ],
              "additionalProperties": false
            },
            "validationErrors": {
              "type": "array",
              "items": {
                "enum": [
                  "UNKNOWN_SDK",
                  "UNSUPPORTED_SCHEMA",
                  "INCOMPATIBLE_RUNTIME",
                  "INVALID_IDENTITY",
                  "INVALID_SCOPE",
                  "INVALID_DEPENDENCY",
                  "REQUIRED_DEPENDENCY_CYCLE",
                  "UNAPPROVED_KNOWLEDGE",
                  "INVALID_GOVERNANCE",
                  "BUILD_INVALIDATING_OUTCOME",
                  "WORK_LIMIT"
                ]
              },
              "maxItems": 50
            }
          },
          "required": [
            "state",
            "profile",
            "capabilities",
            "technicalRatification",
            "schemaVersion",
            "identityVersion",
            "runtimeFingerprint",
            "recipeFingerprint",
            "capabilityFingerprint",
            "sdkVersion",
            "buildId",
            "compatible",
            "mode",
            "coverage",
            "validationErrors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "$ref": "common.schema.json#/$defs/error"
    },
    "counts": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "complete",
        "reason"
      ],
      "additionalProperties": false
    },
    "emptyReason": {
      "anyOf": [
        {
          "enum": [
            "NO_MATCH",
            "UNKNOWN_IN_SCOPE",
            "INCOMPLETE_EVIDENCE",
            "NOT_APPLICABLE",
            "NOT_REQUESTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "normalizedQuery": {
          "type": "string",
          "maxLength": 2048
        },
        "matchedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 50
        },
        "candidatesExamined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "workCharged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "capabilityFingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "normalizedQuery",
        "matchedBy",
        "candidatesExamined",
        "workCharged",
        "capabilityFingerprint"
      ],
      "additionalProperties": false
    },
    "targetSdkVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "versionNotices": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "common.schema.json#/$defs/versionNotice"
      }
    }
  },
  "required": [
    "contractVersion",
    "tool",
    "sdkVersion",
    "buildId",
    "proof",
    "data",
    "error",
    "counts",
    "coverage",
    "emptyReason",
    "truncated",
    "continuation",
    "trace",
    "targetSdkVersion",
    "versionNotices"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "buildId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "sdkVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "proof": {
            "const": "NOT_APPLICABLE"
          },
          "continuation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "buildId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "null"
              }
            }
          },
          "sdkVersion": {
            "type": "null"
          },
          "versionNotices": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "trace": {
            "properties": {
              "capabilityFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "sdkVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  ]
}
